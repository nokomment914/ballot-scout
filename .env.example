# Copy to .env for local development (node dev-server.mjs reads it), and add the same
# values in Vercel (Project > Settings > Environment Variables) and as GitHub repository
# secrets (Settings > Secrets and variables > Actions) for the nightly data job.

# Google Civic Information API key (elections + voter info: contests, polling places).
# https://console.cloud.google.com/apis/library/civicinfo.googleapis.com
GOOGLE_CIVIC_API_KEY=

# api.data.gov key: works for both the Congress.gov API and the OpenFEC API.
# https://api.data.gov/signup/
DATA_GOV_API_KEY=

# NY State Senate Open Legislation API key.
# https://legislation.nysenate.gov/
NYSENATE_API_KEY=

# Open States (Plural) API key for New York Assembly roll calls.
# https://open.pluralpolicy.com/accounts/profile/
OPENSTATES_API_KEY=

# Optional: data.ny.gov app token (raises the rate limit for the NY campaign-finance build).
NY_SOCRATA_APP_TOKEN=

# Optional: where visitors report errors (a GitHub issues page or a mailto: link).
REPORT_ERROR_URL=

# Optional: 1 = fictional sample data, no keys needed (local testing only).
FIXTURES=

# Optional overrides (defaults shown).
# ELECTION_DATE=2026-11-03
# NY_SESSION=2025
# VOTE_CONGRESSES=118,119
# CONGRESS_CALLS_PER_HOUR=900
